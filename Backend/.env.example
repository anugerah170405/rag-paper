APP_NAME=Paper RAG Backend
APP_HOST=127.0.0.1
APP_PORT=8001
TOKEN_SECRET=change-this-secret-key
TOKEN_EXPIRE_MINUTES=1440

# Oracle XE example:
ORACLE_USER=paper_rag
ORACLE_PASSWORD=paper_rag123
ORACLE_DSN=localhost:1521/XE

# Only fill this if your Oracle 11g needs thick client.
# Example:
# ORACLE_CLIENT_LIB_DIR=C:/oraclexe/app/oracle/product/11.2.0/server/bin
ORACLE_CLIENT_LIB_DIR=C:/oraclexe/app/oracle/product/11.2.0/server/bin

# Free AI provider from Google AI Studio.
# Get key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_CHAT_MODEL=gemini-2.0-flash-lite
GEMINI_TIMEOUT_SECONDS=120

UPLOAD_DIR=uploads
